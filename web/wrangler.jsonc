{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sjomatning-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "sjomatning-library" }],
  "d1_databases": [{ "binding": "DB", "database_name": "sjomatning-library", "database_id": "c0741609-f325-4404-9fbd-41793fe0b695", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
