{
  "name": "sjomatning",
  "productName": "Sjömätning",
  "version": "0.1.0",
  "buildDate": "2026-09-12",
  "description": "Fältmanus, mätspår och djupdata för sjömätning",
  "main": "src/main.js",
  "author": "Sjömätning",
  "license": "MIT",
  "repository": "https://github.com/ledkarlsson/Sjomatning",
  "scripts": {
    "web:build": "node web/build.mjs",
    "web:dev": "npm run web:build && wrangler dev --config web/wrangler.jsonc",
    "web:deploy": "npm run web:build && wrangler deploy --config web/wrangler.jsonc",
    "test:mobile-ui": "npm run web:build && electron scripts/mobile-ui-regression.cjs",
    "test:web-api": "node scripts/web-api-test.mjs",
    "start": "electron .",
    "package": "electron-builder --dir",
    "make": "electron-builder --win nsis --publish never",
    "make:mac": "electron-builder --mac --publish never",
    "test": "node --test",
    "test:navigation-ui": "electron scripts/navigation-ui-regression.cjs",
    "test:annotations-ui": "electron scripts/annotations-ui-regression.cjs",
    "test:feedback-ui": "electron scripts/feedback-ui-regression.cjs",
    "test:library-ui": "electron scripts/library-ui-regression.cjs",
    "test:seaclear-ui": "electron scripts/seaclear-ui-regression.cjs",
    "test:map-ui": "electron scripts/map-ui-regression.cjs",
    "lint": "node --check src/main.js && node --check src/live-storage.js && node --check src/preload.js && node --check src/renderer.js && node --check src/nmea-parser.mjs && node --check src/track-parser.mjs && node --check src/track-processing.mjs && node --check src/web-map.mjs && node --check src/roxen-level.js && node --check src/library-store.js && node --check src/raster-chart.mjs && node --check src/track-view.mjs && node --check src/bsb-index.js && node --check src/manuscript-annotations.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "wrangler": "^4.135.0"
  },
  "build": {
    "appId": "se.sjomatning.app",
    "productName": "Sjömätning",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "out"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Sjomatning-${version}-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Sjomatning-${version}-mac-${arch}.${ext}",
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/@napi-rs/canvas-darwin-{arm64,x64}/skia.darwin-*.node",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sjömätning"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ledkarlsson",
        "repo": "Sjomatning"
      }
    ]
  }
}
